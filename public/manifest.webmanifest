{
  "name": "WanderSync",
  "short_name": "WanderSync",
  "description": "Group trips: itineraries, tickets, check-ins, shared expenses and SOS.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f7f6",
  "theme_color": "#0f3a40",
